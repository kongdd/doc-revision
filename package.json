{
  "name": "doc-revision",
  "displayName": "Document Revision",
  "description": "Review unstaged Git changes in a Word-style revision mode",
  "version": "0.1.0",
  "publisher": "lengmh",
  "author": "TinyTigerPan",
  "license": "MIT",
  "icon": "resources/marketplace-icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/lengmh/DiffTracker.git"
  },
  "homepage": "https://github.com/lengmh/DiffTracker#readme",
  "bugs": {
    "url": "https://github.com/lengmh/DiffTracker/issues"
  },
  "keywords": [
    "diff",
    "review",
    "changes",
    "automation",
    "source-control"
  ],
  "galleryBanner": {
    "color": "#1f2937",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "Document Revision reads and can restore workspace file contents."
    }
  },
  "main": "./out/extension.js",
  "activationEvents": [
    "*",
    "onView:DocRevision.changesView"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "DocRevision",
          "title": "Document Revision",
          "icon": "resources/record-icon.svg"
        }
      ]
    },
    "views": {
      "DocRevision": [
        {
          "id": "DocRevision.changesView",
          "name": "修订"
        },
        {
          "id": "DocRevision.navigationView",
          "name": "修订导航"
        }
      ]
    },
    "configuration": {
      "title": "Document Revision",
      "properties": {
        "DocRevision.showRevisions": {
          "type": "boolean",
          "default": false,
          "scope": "resource",
          "description": "Show Git revisions for the current workspace folder."
        },
        "DocRevision.showAllChanges": {
          "type": "boolean",
          "default": false,
          "scope": "resource",
          "description": "Show the net changes against HEAD instead of unstaged changes."
        },
        "DocRevision.showDeletedLinesBadge": {
          "type": "boolean",
          "default": true,
          "description": "Show a badge indicating deleted lines"
        },
        "DocRevision.showDeletedTextInline": {
          "type": "boolean",
          "default": true,
          "description": "Render removed text as red strike-through ghost text inside editable editors (including .typ). Does not modify source files or Typst preview."
        },
        "DocRevision.highlightAddedLines": {
          "type": "boolean",
          "default": true,
          "description": "Highlight added lines with green background"
        },
        "DocRevision.highlightModifiedLines": {
          "type": "boolean",
          "default": false,
          "scope": "resource",
          "description": "Highlight modified lines with a background color"
        },
        "DocRevision.highlightWordChanges": {
          "type": "boolean",
          "default": true,
          "description": "Highlight word-level changes within modified lines"
        }
      }
    },
    "commands": [
      {
        "command": "DocRevision.openSublimeMerge",
        "title": "Open Workspace in Sublime Merge",
        "category": "Document Revision"
      },
      {
        "command": "DocRevision.previousChange",
        "title": "Previous Change",
        "category": "Document Revision",
        "icon": "$(arrow-up)"
      },
      {
        "command": "DocRevision.nextChange",
        "title": "Next Change",
        "category": "Document Revision",
        "icon": "$(arrow-down)"
      },
      {
        "command": "DocRevision.acceptAllRevisions",
        "title": "全部接受当前文件的修订",
        "category": "Document Revision"
      },
      {
        "command": "DocRevision.rejectAllRevisions",
        "title": "全部拒绝当前文件的修订",
        "category": "Document Revision"
      },
      {
        "command": "DocRevision.acceptSelection",
        "title": "接受选中行的修订",
        "category": "Document Revision"
      },
      {
        "command": "DocRevision.rejectSelection",
        "title": "拒绝选中行的修订",
        "category": "Document Revision"
      },
      {
        "command": "DocRevision.toggleGitRevisions",
        "title": "Toggle Git Revisions for Current File",
        "category": "Document Revision"
      }
    ],
    "keybindings": [
      {
        "command": "DocRevision.openSublimeMerge",
        "key": "cmd+ctrl+g",
        "when": "editorTextFocus"
      },
      {
        "command": "DocRevision.toggleGitRevisions",
        "key": "shift+alt+g",
        "mac": "shift+option+g",
        "when": "editorTextFocus && resourceScheme == file"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile",
    "test": "node --test test/change-navigation.mjs test/git-revisions.mjs test/revision-hover.mjs test/simple-sidebar.mjs test/line-changes.mjs test/revision-settings.mjs && node test/live-deleted-text.mjs",
    "lint": "eslint src",
    "package": "node -e \"require('fs').mkdirSync('dist',{recursive:true})\" && vsce package --out dist"
  },
  "devDependencies": {
    "@types/node": "^20.x",
    "@types/vscode": "1.80.0",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "@vscode/vsce": "^4.0.0",
    "eslint": "^10.10.0",
    "typescript": "^5.2.0"
  },
  "dependencies": {
    "diff": "^8.0.3"
  }
}
