{
  "name": "code-diff-tracker",
  "displayName": "Code Diff Tracker",
  "description": "Review unstaged Git changes in a Word-style revision mode",
  "version": "0.8.11",
  "publisher": "lengmh",
  "author": "TinyTigerPan",
  "license": "MIT",
  "icon": "resources/marketplace-icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/lengmh/DiffTracker.git"
  },
  "homepage": "https://github.com/lengmh/DiffTracker#readme",
  "bugs": {
    "url": "https://github.com/lengmh/DiffTracker/issues"
  },
  "keywords": [
    "diff",
    "review",
    "changes",
    "automation",
    "source-control"
  ],
  "galleryBanner": {
    "color": "#1f2937",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "Code Diff Tracker reads and can restore workspace file contents."
    }
  },
  "main": "./out/extension.js",
  "activationEvents": [
    "onStartupFinished",
    "onView:diffTracker.changesView"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "diffTracker",
          "title": "Code Diff Tracker",
          "icon": "resources/record-icon.svg"
        }
      ]
    },
    "views": {
      "diffTracker": [
        {
          "id": "diffTracker.changesView",
          "name": "修订"
        }
      ]
    },
    "configuration": {
      "title": "Code Diff Tracker",
      "properties": {
        "diffTracker.showDeletedLinesBadge": {
          "type": "boolean",
          "default": true,
          "description": "Show a badge indicating deleted lines"
        },
        "diffTracker.showDeletedTextInline": {
          "type": "boolean",
          "default": true,
          "description": "Render removed text as red strike-through ghost text inside editable editors (including .typ). Does not modify source files or Typst preview."
        },
        "diffTracker.highlightAddedLines": {
          "type": "boolean",
          "default": true,
          "description": "Highlight added lines with green background"
        },
        "diffTracker.highlightModifiedLines": {
          "type": "boolean",
          "default": false,
          "description": "Highlight modified lines with a background color"
        },
        "diffTracker.highlightWordChanges": {
          "type": "boolean",
          "default": true,
          "description": "Highlight word-level changes within modified lines"
        }
      }
    },
    "commands": [
      {
        "command": "diffTracker.previousChange",
        "title": "Previous Change",
        "category": "Code Diff Tracker",
        "icon": "$(arrow-up)"
      },
      {
        "command": "diffTracker.nextChange",
        "title": "Next Change",
        "category": "Code Diff Tracker",
        "icon": "$(arrow-down)"
      },
      {
        "command": "diffTracker.toggleGitRevisions",
        "title": "Toggle Git Revisions for Current File",
        "category": "Code Diff Tracker"
      }
    ],
    "menus": {},
    "keybindings": [
      {
        "command": "diffTracker.toggleGitRevisions",
        "key": "shift+alt+g",
        "mac": "shift+option+g",
        "when": "editorTextFocus && resourceScheme == file"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile",
    "test": "node --test test/change-navigation.mjs test/git-revisions.mjs test/revision-hover.mjs test/simple-sidebar.mjs test/line-changes.mjs && node test/live-deleted-text.mjs",
    "lint": "eslint src",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.x",
    "@types/vscode": "1.80.0",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "@vscode/vsce": "^4.0.0",
    "eslint": "^10.10.0",
    "typescript": "^5.2.0"
  },
  "dependencies": {
    "diff": "^8.0.3"
  }
}
